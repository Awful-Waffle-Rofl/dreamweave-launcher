<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DreamWeaveLauncher</AssemblyName>
    <RootNamespace>DreamWeave.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dreamweave.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <!-- Dependency DLLs ship as ordinary files beside the exe (no packer). Keep referenced assemblies' XML docs and satellite resource folders out of the output. The shipped set is installer/shipped-files.txt. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Launcher.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Art and icons stay embedded in the exe. -->
    <EmbeddedResource Include="Assets\*.jpg;Assets\*.png;Assets\*.ico" LogicalName="Assets.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The license notices for the shipped third-party DLLs travel beside the exe; a test keeps this equal to the shipped section of THIRD-PARTY-NOTICES.md. -->
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
    <!-- Build the isolated x86 Decal helper before this project and never reference its assembly: only
         its exit-code/token contract is shared, as source (DecalLaunchResult.cs), so the main launcher
         loads nothing 32-bit at runtime. The helper's output is copied beside this exe below. -->
    <ProjectReference Include="..\DecalLaunch\DecalLaunch.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\DecalLaunch\DecalLaunchResult.cs" Link="Decal\DecalLaunchResult.cs" />
  </ItemGroup>
  <!-- The setup ships DreamWeaveDecalLaunch.exe from this folder (installer/shipped-files.txt). -->
  <Target Name="CopyDecalHelper" AfterTargets="Build">
    <ItemGroup>
      <DecalHelperOutput Include="$(MSBuildThisFileDirectory)..\DecalLaunch\bin\$(Configuration)\net48\DreamWeaveDecalLaunch.exe" />
      <DecalHelperOutput Include="$(MSBuildThisFileDirectory)..\DecalLaunch\bin\$(Configuration)\net48\DreamWeaveDecalLaunch.pdb" />
    </ItemGroup>
    <!-- The helper builds first (ProjectReference above), so its exe is always present. Missing after a Release build means a broken build: fail loudly rather than ship a launcher without it. -->
    <Error Condition="'$(Configuration)' == 'Release' And !Exists('$(MSBuildThisFileDirectory)..\DecalLaunch\bin\$(Configuration)\net48\DreamWeaveDecalLaunch.exe')" Text="DreamWeaveDecalLaunch.exe was not found after the build (src\DecalLaunch\bin\$(Configuration)\net48). The Decal helper must be built before the launcher is packaged." />
    <Copy SourceFiles="@(DecalHelperOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(DecalHelperOutput.Identity)')" />
  </Target>
</Project>
