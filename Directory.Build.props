<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- The launcher's version: read at run time through the assembly informational version (LauncherInfo.Version). -->
    <Version>1.0.0</Version>
    <Product>DreamWeave Launcher</Product>
    <Company>DreamWeave</Company>
    <Copyright>Copyright (c) 2026 Awful-Waffle-Rofl</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lets net48 build without the .NET Framework 4.8 Developer Pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
