<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>DreamWeave.Launcher.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Launcher.Core\Launcher.Core.csproj" />
    <ProjectReference Include="..\..\src\Launcher\Launcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\manifest\manifest.sample.json" Link="manifest.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Decal helper's input validation is tested in-process (AnyCPU) by compiling its source here;
         the helper assembly itself is 32-bit-required and cannot be loaded into the test host. Its wire
         contract (DecalLaunchResult) is provided by the referenced Launcher assembly, which links it. -->
    <Compile Include="..\..\src\DecalLaunch\DecalLaunchInputs.cs" Link="Decal\DecalLaunchInputs.cs" />
  </ItemGroup>
</Project>